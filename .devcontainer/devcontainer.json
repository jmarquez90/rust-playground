{
  "name": "rust-playground",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--cap-add=PERFMON"],
  "remoteUser": "dev",
  "containerEnv": { "CARGO_TARGET_DIR": "/home/dev/target" },
  "mounts": [
    "source=rust-playground-target,target=/home/dev/target,type=volume",
    "source=rust-playground-registry,target=/usr/local/cargo/registry,type=volume"
  ],
  "customizations": {
    "vscode": { "extensions": ["rust-lang.rust-analyzer"] },
    "jetbrains": {
      "backend": "PyCharm",
      "plugins": ["com.jetbrains.rust"]
    }
  },
  
}